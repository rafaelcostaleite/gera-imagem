# Banco de dados
DATABASE_URL=postgresql://admin:admin123@db:5432/it_cases

# Segurança
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Active Directory / LDAP
AD_SERVER=ldap://your-ad-server.com
AD_DOMAIN=your-domain.com
AD_BASE_DN=DC=your-domain,DC=com
AD_USE_SSL=False

# Desenvolvimento (use False em produção)
DEVELOPMENT_MODE=True
DEV_DEFAULT_PASSWORD=123456

# Aplicação
PROJECT_NAME=Sistema de Gestão de Casos TI
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
